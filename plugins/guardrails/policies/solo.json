{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git:*)",
      "Bash(ls:*)", "Bash(pwd)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)",
      "Bash(rg:*)", "Bash(grep:*)", "Bash(find:*)", "Bash(which:*)", "Bash(jq:*)",
      "Bash(npm:*)", "Bash(pnpm:*)", "Bash(yarn:*)", "Bash(bun:*)",
      "Bash(pytest:*)", "Bash(python:*)", "Bash(uv:*)", "Bash(ruff:*)",
      "Bash(go:*)", "Bash(cargo:*)", "Bash(make:*)",
      "Bash(gh:*)", "Bash(docker:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)", "Bash(git push -f:*)",
      "Bash(npm publish:*)", "Bash(cargo publish:*)", "Bash(twine upload:*)",
      "Bash(terraform apply:*)", "Bash(terraform destroy:*)",
      "Read(./.env)", "Read(~/.aws/**)", "Read(~/.ssh/**)",
      "Write(./.env)", "Write(./secrets/**)"
    ]
  }
}
