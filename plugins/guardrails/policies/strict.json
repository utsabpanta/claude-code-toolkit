{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(git branch:*)", "Bash(git remote -v)", "Bash(git rev-parse:*)", "Bash(git blame:*)",
      "Bash(ls:*)", "Bash(pwd)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)",
      "Bash(rg:*)", "Bash(grep:*)", "Bash(find:*)", "Bash(which:*)",
      "Bash(gh pr view:*)", "Bash(gh pr list:*)", "Bash(gh issue view:*)", "Bash(gh issue list:*)"
    ],
    "ask": [
      "Bash(npm:*)", "Bash(pnpm:*)", "Bash(yarn:*)", "Bash(pip:*)", "Bash(uv:*)",
      "Bash(go:*)", "Bash(cargo:*)", "Bash(make:*)", "Bash(docker:*)", "Bash(kubectl:*)",
      "Bash(terraform:*)", "Bash(git commit:*)", "Bash(git push:*)", "Bash(gh:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(gh pr merge:*)", "Bash(gh release create:*)",
      "Bash(npm publish:*)", "Bash(cargo publish:*)", "Bash(pypi:*)", "Bash(twine upload:*)",
      "Bash(terraform apply:*)", "Bash(terraform destroy:*)",
      "Bash(kubectl delete:*)", "Bash(kubectl apply:*)",
      "Bash(aws:*)", "Bash(gcloud:*)", "Bash(az:*)",
      "Bash(curl:*)", "Bash(wget:*)",
      "Read(./.env)", "Read(./.env.*)", "Read(./secrets/**)",
      "Read(~/.aws/**)", "Read(~/.ssh/**)", "Read(~/.config/gh/**)",
      "Write(./.env)", "Write(./.env.*)", "Write(./secrets/**)"
    ]
  },
  "disableBypassPermissionsMode": "disable"
}
